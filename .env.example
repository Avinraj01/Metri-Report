# METRIREPORT Environment Variables

# Application Security
SECRET_KEY=metrireport-sih-2026-production-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Defaults to SQLite; supports PostgreSQL)
DATABASE_URL=sqlite:///./metrireport.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/metrireport

# Google OAuth 2.0 / OpenID Connect (Optional - Local demo works 100% offline without these)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# File Storage & Uploads
UPLOAD_DIR=./backend/uploads
MAX_UPLOAD_SIZE_BYTES=15728640
